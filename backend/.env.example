# Copy to .env. Defaults are suitable for a loopback-only local demo.
AUTH_MODE=local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RETRACE_DATA_DIR=/absolute/path/to/private/retrace-data
# Optional Supabase Auth mode (application persistence remains SQLite):
# AUTH_MODE=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
